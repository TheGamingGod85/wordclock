
(rules PCB freerouting.dsn
  (snapAngle 
    fortyfive_degree
  )
  (rule
    (width 500.0)
    (clearance 150.0)
    (clearance 250.0 (type smd_to_turn_gap))
    (clearance 37.6 (type smd))
    (clearance 150.0 (type "PWR_1P5,Default"))
    (clearance 150.0 (type POWER,Default))
    (clearance 150.0 (type "PWR_2MM,Default"))
    (clearance 250.0 (type "board_edge"))
  )
  (padstack "Via[0-1]_700:400_um"
    (shape
      (circle F.Cu 700.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 700.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_700:400_um" "Via[0-1]_700:400_um" default
  )
  (via 
    "Via[0-1]_700:400_um-PWR_1P5,Default" "Via[0-1]_700:400_um" "PWR_1P5,Default"
  )
  (via 
    "Via[0-1]_700:400_um-POWER,Default" "Via[0-1]_700:400_um" POWER,Default
  )
  (via 
    "Via[0-1]_700:400_um-PWR_2MM,Default" "Via[0-1]_700:400_um" "PWR_2MM,Default"
  )
  (viaRule
    default "Via[0-1]_700:400_um"
  )
  (viaRule
    default "Via[0-1]_700:400_um"
  )
  (viaRule
    "PWR_1P5,Default" "Via[0-1]_700:400_um-PWR_1P5,Default"
  )
  (viaRule
    POWER,Default "Via[0-1]_700:400_um-POWER,Default"
  )
  (viaRule
    "PWR_2MM,Default" "Via[0-1]_700:400_um-PWR_2MM,Default"
  )
  (class default
    /GND
    (clearance_class default)
    (via_rule default)
    (rule
      (width 500.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "PWR_1P5,Default"
    "/+5V_CORNER" "/+5V_CTRL"
    (clearance_class "PWR_1P5,Default")
    (via_rule "PWR_1P5,Default")
    (rule
      (width 2000.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class POWER,Default
    "/+5V_IN"
    (clearance_class POWER,Default)
    (via_rule POWER,Default)
    (rule
      (width 4000.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "PWR_2MM,Default"
    "/+5V_MAIN" "/+5V_R2" "/+5V_R3" "/+5V_R4" "/+5V_R10" "/+5V_R7" "/+5V_R6" "/+5V_R8"
    "/+5V_R1" "/+5V_R9" "/+5V_R5"
    (clearance_class "PWR_2MM,Default")
    (via_rule "PWR_2MM,Default")
    (rule
      (width 4000.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)